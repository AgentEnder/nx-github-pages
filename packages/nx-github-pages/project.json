{
  "name": "nx-github-pages",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nx-github-pages/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/nx-github-pages",
        "main": "packages/nx-github-pages/src/index.ts",
        "tsConfig": "packages/nx-github-pages/tsconfig.lib.json",
        "assets": [
          "*.md",
          "LICENSE",
          {
            "input": "packages/nx-github-pages/src",
            "glob": "**/!(*.ts)",
            "output": "src"
          },
          {
            "input": "packages/nx-github-pages/src",
            "glob": "**/*.d.ts",
            "output": "src"
          },
          {
            "input": "packages/nx-github-pages/",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "packages/nx-github-pages/",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/nx-github-pages/src",
          "{projectRoot}/package.json",
          "packages/nx-github-pages/package.json",
          "executors.json",
          "generators.json"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectName}"],
      "options": {
        "jestConfig": "packages/nx-github-pages/jest.config.ts"
      }
    },
    "deploy": {
      "executor": "nx-github-pages:deploy",
      "options": {
        "user": {
          "name": "GitHub Actions",
          "email": ""
        }
      },
      "dependsOn": ["build"]
    }
  }
}
